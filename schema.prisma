// datasource and generator configuration
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "extendedWhereUnique"]
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Province {
  KOSHI
  MADHESH
  BAGMATI
  GANDAKI
  LUMBINI
  KARNALI
  SUDURPASHCHIM
}

enum DeliveryZone {
  INSIDE_RING_ROAD_VALLEY
  OUTSIDE_RING_ROAD_VALLEY
  OUTSIDE_VALLEY_MAJOR_CITY
  REMOTE_DISTRICT
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  ORDER_PLACED
  PROCESSING
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  REFUNDED
}

enum PaymentGateway {
  ESEWA
  KHALTI
  FONEPAY_QR
  CASH_ON_DELIVERY
  CONNECT_IPS
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  EXPIRED
}

enum OtpPurpose {
  LOGIN_REGISTRATION
  CHECKOUT_VERIFICATION
  PASSWORD_RESET
  PHONE_CHANGE
}

// ==========================================
// USER, AUTH & PROFILES
// ==========================================

model User {
  id               String       @id @default(uuid()) @db.Uuid
  phone            String       @unique @db.VarChar(15) // E.164 e.g. +9779841234567
  email            String?      @unique @db.VarChar(255)
  fullName         String?      @db.VarChar(150)
  role             UserRole     @default(CUSTOMER)
  status           UserStatus   @default(ACTIVE)
  isPhoneVerified  Boolean      @default(false)
  avatarUrl        String?      @db.Text
  preferredLanguage String      @default("ne") @db.VarChar(5) // "ne" or "en"
  
  // Relations
  addresses        AddressBook[]
  orders           Order[]
  cart             Cart?
  sellerProfile    SellerProfile?
  refreshTokens    RefreshToken[]
  otps             OtpVerification[]
  reviews          ProductReview[]
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([phone])
  @@index([role])
  @@map("users")
}

model SellerProfile {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  storeName        String       @unique @db.VarChar(150)
  storeSlug        String       @unique @db.VarChar(150)
  storeDescription String?      @db.Text
  storeLogoUrl     String?      @db.Text
  storeBannerUrl   String?      @db.Text
  panNumber        String?      @unique @db.VarChar(20) // Nepal Inland Revenue PAN
  isPanVerified    Boolean      @default(false)
  isVerifiedSeller Boolean      @default(false)
  commissionRate   Decimal      @default(5.00) @db.Decimal(5, 2) // % commission
  
  // Relations
  products         Product[]
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("seller_profiles")
}

model RefreshToken {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tokenHash        String       @unique @db.VarChar(255)
  family           String       @db.Uuid // Token rotation family
  isRevoked        Boolean      @default(false)
  expiresAt        DateTime
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId, family])
  @@map("refresh_tokens")
}

model OtpVerification {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String?      @db.Uuid
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  phone            String       @db.VarChar(15)
  otpHash          String       @db.VarChar(255)
  purpose          OtpPurpose   @default(LOGIN_REGISTRATION)
  attempts         Int          @default(0)
  maxAttempts      Int          @default(3)
  isConsumed       Boolean      @default(false)
  expiresAt        DateTime
  
  createdAt        DateTime     @default(now())

  @@index([phone, isConsumed, expiresAt])
  @@map("otp_verifications")
}

// ==========================================
// ADDRESS BOOK (NEPAL SPECIFIC HIERARCHY)
// ==========================================

model AddressBook {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @db.Uuid
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  contactName          String       @db.VarChar(100)
  contactPhone         String       @db.VarChar(15)
  
  province             Province
  district             String       @db.VarChar(80)  // e.g. Kathmandu, Lalitpur, Kaski, Morang
  municipality         String       @db.VarChar(100) // e.g. Kathmandu Metropolitan City, Pokhara Lekhnath
  wardNumber           Int                           // e.g. 10
  toleOrStreet         String       @db.VarChar(150) // e.g. Baneshwor Heights, New Baneshwor
  landmark             String?      @db.VarChar(150) // e.g. Opposite to Everest Hotel
  deliveryInstructions String?      @db.Text
  
  deliveryZone         DeliveryZone @default(INSIDE_RING_ROAD_VALLEY)
  isDefault            Boolean      @default(false)
  
  orders               Order[]
  
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([userId, isDefault])
  @@map("address_books")
}

// ==========================================
// CATALOG: CATEGORIES, BRANDS, PRODUCTS & VARIANTS
// ==========================================

model Category {
  id               String       @id @default(uuid()) @db.Uuid
  parentId         String?      @db.Uuid
  parent           Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]   @relation("CategoryHierarchy")
  
  name             String       @db.VarChar(100)
  nameNepali       String?      @db.VarChar(100) // Devanagari translation
  slug             String       @unique @db.VarChar(120)
  description      String?      @db.Text
  iconUrl          String?      @db.Text
  bannerUrl        String?      @db.Text
  displayOrder     Int          @default(0)
  isActive         Boolean      @default(true)
  
  products         Product[]
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @unique @db.VarChar(100)
  slug             String       @unique @db.VarChar(120)
  logoUrl          String?      @db.Text
  website          String?      @db.VarChar(255)
  isLocalNepali    Boolean      @default(false) // Tag for authentic Nepali crafts/producers
  
  products         Product[]
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("brands")
}

model Product {
  id                 String           @id @default(uuid()) @db.Uuid
  sellerId           String           @db.Uuid
  seller             SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  
  categoryId         String           @db.Uuid
  category           Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  brandId            String?          @db.Uuid
  brand              Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  
  title              String           @db.VarChar(255)
  titleNepali        String?          @db.VarChar(255)
  slug               String           @unique @db.VarChar(280)
  description        String           @db.Text
  status             ProductStatus    @default(ACTIVE)
  
  isAuthenticGuarantee Boolean        @default(true)
  isCodAvailable     Boolean          @default(true)
  weightGrams        Int              @default(500)
  
  // Aggregated metadata
  averageRating      Decimal          @default(0.00) @db.Decimal(3, 2)
  reviewCount        Int              @default(0)
  
  // Relations
  variants           ProductVariant[]
  reviews            ProductReview[]
  
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([categoryId, status])
  @@index([sellerId])
  @@index([title])
  @@map("products")
}

model ProductVariant {
  id               String       @id @default(uuid()) @db.Uuid
  productId        String       @db.Uuid
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sku              String       @unique @db.VarChar(100)
  variantName      String       @db.VarChar(150) // e.g. "50g Resin", "Navy Blue / XL"
  
  priceNpr         Decimal      @db.Decimal(12, 2)
  compareAtPriceNpr Decimal?    @db.Decimal(12, 2) // Strikethrough price
  costPriceNpr     Decimal?     @db.Decimal(12, 2)
  
  stockQuantity    Int          @default(0)
  lowStockThreshold Int         @default(5)
  
  images           String[]     // Array of Cloudinary/S3 image URLs
  attributes       Json         // e.g. {"size": "50g", "color": "Navy"}
  
  cartItems        CartItem[]
  orderItems       OrderItem[]
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([priceNpr])
  @@map("product_variants")
}

model ProductReview {
  id               String       @id @default(uuid()) @db.Uuid
  productId        String       @db.Uuid
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  userId           String       @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating           Int          @db.SmallInt // 1 to 5
  reviewText       String?      @db.Text
  imageUrls        String[]
  isVerifiedPurchase Boolean    @default(true)
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([productId, userId])
  @@map("product_reviews")
}

// ==========================================
// CART
// ==========================================

model Cart {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items            CartItem[]
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("carts")
}

model CartItem {
  id               String         @id @default(uuid()) @db.Uuid
  cartId           String         @db.Uuid
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  
  variantId        String         @db.Uuid
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  quantity         Int            @default(1)
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ==========================================
// ORDERS & CHECKOUT
// ==========================================

model Order {
  id                   String               @id @default(uuid()) @db.Uuid
  orderNumber          String               @unique @db.VarChar(30) // e.g. "DHAN-20261007-89241"
  userId               String               @db.Uuid
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  shippingAddressId    String               @db.Uuid
  shippingAddress      AddressBook          @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  
  // Preserved address snapshot for historical integrity
  shippingSnapshot     Json
  
  orderStatus          OrderStatus          @default(PENDING_PAYMENT)
  
  // Financial breakdown in NPR
  subtotalNpr          Decimal              @db.Decimal(12, 2)
  deliveryFeeNpr       Decimal              @db.Decimal(12, 2)
  discountNpr          Decimal              @default(0.00) @db.Decimal(12, 2)
  taxVatNpr            Decimal              @default(0.00) @db.Decimal(12, 2)
  totalAmountNpr       Decimal              @db.Decimal(12, 2)
  
  voucherCode          String?              @db.VarChar(50)
  idempotencyKey       String?              @unique @db.VarChar(100)
  
  items                OrderItem[]
  paymentTransactions  PaymentTransaction[]
  
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([userId, orderStatus])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @db.Uuid
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  variantId        String         @db.Uuid
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  
  productTitle     String         @db.VarChar(255)
  variantTitle     String         @db.VarChar(150)
  sku              String         @db.VarChar(100)
  thumbnailUrl     String?        @db.Text
  
  unitPriceNpr     Decimal        @db.Decimal(12, 2)
  quantity         Int
  totalPriceNpr    Decimal        @db.Decimal(12, 2)
  
  createdAt        DateTime       @default(now())

  @@index([orderId])
  @@map("order_items")
}

// ==========================================
// PAYMENT TRANSACTIONS (eSewa, Khalti, COD, Fonepay)
// ==========================================

model PaymentTransaction {
  id                 String          @id @default(uuid()) @db.Uuid
  orderId            String          @db.Uuid
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  
  gateway            PaymentGateway
  status             PaymentStatus   @default(INITIATED)
  
  amountNpr          Decimal         @db.Decimal(12, 2)
  
  // Gateway specific identifiers
  transactionUuid    String          @unique @db.VarChar(100) // Internal unique transaction identifier
  gatewayReferenceId String?         @db.VarChar(100)         // e.g. Khalti pidx or eSewa refId
  
  // Raw signature and payloads
  signature          String?         @db.Text                 // HMAC-SHA256 signature
  gatewayRequest     Json?
  gatewayResponse    Json?
  failureReason      String?         @db.Text
  
  verifiedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([orderId])
  @@index([transactionUuid])
  @@index([gatewayReferenceId])
  @@map("payment_transactions")
}
