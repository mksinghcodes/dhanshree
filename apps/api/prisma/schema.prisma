// ==============================================================================
// PRISMA SCHEMA: WORLD-CLASS MULTI-VENDOR MARKETPLACE
// Targeted Launch: Nepal (NP), India (IN), UAE (AE)
// Engine: PostgreSQL 16
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SELLER
  BUYER
  SUPPORT
  FINANCE
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  DOCUMENTS_REQUESTED
}

enum ProductStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
  ARCHIVED
}

enum ListingType {
  STANDARD
  AUCTION
  RFQ_BULK
}

enum AuctionStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
  RESERVE_NOT_MET
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  COD_PENDING_VERIFICATION
  PROCESSING
  PACKED
  HANDED_OVER_TO_COURIER
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RTO_INITIATED
  RTO_DELIVERED
  CANCELLED
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  ESCROW_HELD
}

enum EscrowStatus {
  NOT_APPLICABLE
  HELD
  RELEASED_TO_SELLER
  DISPUTED
  REFUNDED_TO_BUYER
}

enum CodRiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  ITEM_RECEIVED
  INSPECTION_PASSED
  REFUND_ISSUED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  ON_HOLD
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

// ------------------------------------------------------------------------------
// GEOGRAPHY, LOCALIZATION & TAXATION
// ------------------------------------------------------------------------------

model Country {
  code            String      @id @db.VarChar(2) // NP, IN, AE
  name            String      @db.VarChar(100)
  nativeName      String      @db.VarChar(100)
  defaultCurrency String      @db.VarChar(3) // NPR, INR, AED
  defaultLanguage String      @db.VarChar(5) // en, ne, hi, ar
  phonePrefix     String      @db.VarChar(10) // +977, +91, +971
  isRtlDefault    Boolean     @default(false)
  isOperational   Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  taxRules        TaxRule[]
  addresses       Address[]
  warehouses      Warehouse[]
  productPrices   ProductCountryPrice[]
  orders          Order[]

  @@map("countries")
}

model Currency {
  code               String   @id @db.VarChar(3) // NPR, INR, AED, USD
  name               String   @db.VarChar(50)
  symbol             String   @db.VarChar(10)
  exchangeRateToBase Decimal  @default(1.000000) @db.Decimal(14, 6) // Base currency USD or AED
  decimalDigits      Int      @default(2)
  isActive           Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  @@map("currencies")
}

model TaxRule {
  id               String   @id @default(uuid()) @db.Uuid
  countryCode      String   @db.VarChar(2)
  taxType          String   @db.VarChar(50) // NEPAL_VAT, INDIA_GST_INTRA, INDIA_GST_INTER, UAE_VAT
  name             String   @db.VarChar(100)
  ratePercent      Decimal  @db.Decimal(5, 2) // e.g. 13.00, 18.00, 5.00
  hsnSacCode       String?  @db.VarChar(20) // India HSN / SAC Code
  isReverseCharge  Boolean  @default(false)
  tcsPercent       Decimal  @default(0.00) @db.Decimal(5, 2) // India TCS 1.00%
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  country          Country  @relation(fields: [countryCode], references: [code])

  @@index([countryCode, taxType])
  @@map("tax_rules")
}

// ------------------------------------------------------------------------------
// USERS, AUTHENTICATION & ACCESS CONTROL
// ------------------------------------------------------------------------------

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  email                String        @unique @db.VarChar(255)
  phoneNumber          String?       @unique @db.VarChar(25)
  passwordHash         String?       @db.VarChar(255)
  fullName             String        @db.VarChar(150)
  avatarUrl            String?       @db.VarChar(500)
  role                 UserRole      @default(BUYER)
  status               UserStatus    @default(ACTIVE)
  isEmailVerified      Boolean       @default(false)
  isPhoneVerified      Boolean       @default(false)
  twoFactorEnabled     Boolean       @default(false)
  twoFactorSecret      String?       @db.VarChar(255)
  preferredCountry     String        @default("NP") @db.VarChar(2)
  preferredLanguage    String        @default("en") @db.VarChar(5)
  preferredCurrency    String        @default("NPR") @db.VarChar(3)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sessions             UserSession[]
  addresses            Address[]
  sellerProfile        SellerProfile?
  orders               Order[]
  reviews              Review[]
  bids                 AuctionBid[]
  cart                 Cart?
  notifications        Notification[]
  returns              OrderReturn[]
  couponUsages         CouponUsage[]
  rfqInquiries         RfqInquiry[]

  @@index([email])
  @@index([phoneNumber])
  @@map("users")
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique @db.VarChar(255)
  ipAddress    String?   @db.VarChar(45)
  userAgent    String?   @db.VarChar(500)
  isRevoked    Boolean   @default(false)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Address {
  id                   String      @id @default(uuid()) @db.Uuid
  userId               String      @db.Uuid
  countryCode          String      @db.VarChar(2)
  fullName             String      @db.VarChar(150)
  phone                String      @db.VarChar(25)
  alternatePhone       String?     @db.VarChar(25)
  isDefaultShipping    Boolean     @default(false)
  isDefaultBilling     Boolean     @default(false)

  // Nepal Localized Fields
  province             String?     @db.VarChar(100) // e.g. Bagmati
  district             String?     @db.VarChar(100) // e.g. Kathmandu
  municipality         String?     @db.VarChar(150) // e.g. Kathmandu Metropolitan City
  wardNumber           Int?        // 1 - 32
  toleStreet           String?     @db.VarChar(200)

  // India Localized Fields
  state                String?     @db.VarChar(100) // e.g. Maharashtra
  districtCity         String?     @db.VarChar(100) // e.g. Mumbai
  pinCode              String?     @db.VarChar(10)  // 6-digit PIN
  addressLine1         String?     @db.VarChar(255)
  addressLine2         String?     @db.VarChar(255)

  // UAE Localized Fields
  emirate              String?     @db.VarChar(50)  // Dubai, Abu Dhabi, Sharjah, etc.
  areaNeighborhood     String?     @db.VarChar(150) // e.g. Downtown Dubai
  streetName           String?     @db.VarChar(150)
  buildingVillaName    String?     @db.VarChar(150)
  apartmentVillaNumber String?     @db.VarChar(50)
  makaniNumber         String?     @db.VarChar(20)  // 10-digit Makani
  poBox                String?     @db.VarChar(20)

  landmark             String?     @db.VarChar(200)
  latitude             Decimal?    @db.Decimal(10, 7)
  longitude            Decimal?    @db.Decimal(10, 7)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  country              Country     @relation(fields: [countryCode], references: [code])
  warehouses           Warehouse[]
  orders               Order[]

  @@index([userId])
  @@index([countryCode])
  @@map("addresses")
}

// ------------------------------------------------------------------------------
// SELLERS, STORES & COUNTRY KYC
// ------------------------------------------------------------------------------

model SellerProfile {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @unique @db.Uuid
  companyName          String        @db.VarChar(200)
  businessType         String        @db.VarChar(50) // Individual, Pvt Ltd, LLC, Sole Proprietor
  operationalCountry   String        @db.VarChar(2)  // NP, IN, AE
  kycStatus            KycStatus     @default(PENDING)
  kycRejectionReason   String?       @db.Text

  // Nepal Seller KYC Fields
  nepalPanVatNumber    String?       @db.VarChar(50)
  nepalCitizenshipDoc  String?       @db.VarChar(500)
  nepalCompanyRegDoc   String?       @db.VarChar(500)

  // India Seller KYC Fields
  indiaPanNumber       String?       @db.VarChar(20)
  indiaGstinNumber     String?       @db.VarChar(30)
  indiaCinNumber       String?       @db.VarChar(30)
  indiaGstVerified     Boolean       @default(false)

  // UAE Seller KYC Fields
  uaeTradeLicenseNo    String?       @db.VarChar(50)
  uaeTradeLicenseDoc   String?       @db.VarChar(500)
  uaeTradeLicenseExpiry DateTime?
  uaeEmiratesIdMasked  String?       @db.VarChar(30)
  uaeVatTrnNumber      String?       @db.VarChar(30)

  // Financial & Bank Details
  bankName             String?       @db.VarChar(100)
  bankAccountNumber    String?       @db.VarChar(50)
  bankIbanOrSwift      String?       @db.VarChar(50)
  bankBranchOrIfsc     String?       @db.VarChar(50)

  commissionRate       Decimal       @default(10.00) @db.Decimal(5, 2) // 10% platform fee
  isFeaturedSeller     Boolean       @default(false)
  verifiedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stores               Store[]
  warehouses           Warehouse[]
  products             Product[]
  orderItems           OrderItem[]
  escrowHolds          EscrowHold[]
  payouts              SellerPayout[]
  orderReturns         OrderReturn[]

  @@map("seller_profiles")
}

model Store {
  id                   String        @id @default(uuid()) @db.Uuid
  sellerId             String        @db.Uuid
  name                 String        @db.VarChar(150)
  slug                 String        @unique @db.VarChar(150)
  description          String?       @db.Text
  logoUrl              String?       @db.VarChar(500)
  bannerUrl            String?       @db.VarChar(500)
  ratingAverage        Decimal       @default(0.00) @db.Decimal(3, 2)
  ratingCount          Int           @default(0)
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  seller               SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products             Product[]
  orderItems           OrderItem[]

  @@index([sellerId])
  @@index([slug])
  @@map("stores")
}

// ------------------------------------------------------------------------------
// CATALOG: CATEGORIES, BRANDS, PRODUCTS, VARIANTS
// ------------------------------------------------------------------------------

model Category {
  id             String      @id @default(uuid()) @db.Uuid
  parentId       String?     @db.Uuid
  name           String      @db.VarChar(120)
  slug           String      @unique @db.VarChar(150)
  description    String?     @db.Text
  iconUrl        String?     @db.VarChar(500)
  bannerUrl      String?     @db.VarChar(500)
  displayOrder   Int         @default(0)
  level          Int         @default(0)
  hierarchyPath  String      @db.VarChar(255) // Materialized path e.g. /root-id/cat-id
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  parent         Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]  @relation("CategoryHierarchy")
  products       Product[]

  @@index([parentId])
  @@index([slug])
  @@index([hierarchyPath])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(150)
  logoUrl     String?   @db.VarChar(500)
  description String?   @db.Text
  websiteUrl  String?   @db.VarChar(255)
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
  @@map("brands")
}

model Product {
  id                   String        @id @default(uuid()) @db.Uuid
  sellerId             String        @db.Uuid
  storeId              String        @db.Uuid
  categoryId           String        @db.Uuid
  brandId              String?       @db.Uuid
  title                String        @db.VarChar(255)
  slug                 String        @unique @db.VarChar(255)
  description          String        @db.Text
  shortDescription     String?       @db.VarChar(500)
  listingType          ListingType   @default(STANDARD)
  status               ProductStatus @default(DRAFT)
  sku                  String        @unique @db.VarChar(100)
  basePrice            Decimal       @db.Decimal(12, 2)
  baseCurrency         String        @default("NPR") @db.VarChar(3)
  ratingAverage        Decimal       @default(0.00) @db.Decimal(3, 2)
  reviewCount          Int           @default(0)
  isFeatured           Boolean       @default(false)

  // SEO Fields
  seoTitle             String?       @db.VarChar(255)
  seoDescription       String?       @db.VarChar(500)
  seoKeywords          String?       @db.VarChar(500)

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  seller               SellerProfile @relation(fields: [sellerId], references: [id])
  store                Store         @relation(fields: [storeId], references: [id])
  category             Category      @relation(fields: [categoryId], references: [id])
  brand                Brand?        @relation(fields: [brandId], references: [id])

  images               ProductImage[]
  variants             ProductVariant[]
  countryPrices        ProductCountryPrice[]
  auction              Auction?
  rfqInquiries         RfqInquiry[]
  reviews              Review[]

  @@index([sellerId])
  @@index([storeId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([listingType])
  @@map("products")
}

model ProductCountryPrice {
  id                  String   @id @default(uuid()) @db.Uuid
  productId           String   @db.Uuid
  countryCode         String   @db.VarChar(2)
  currency            String   @db.VarChar(3)
  originalPrice       Decimal  @db.Decimal(12, 2)
  salePrice           Decimal? @db.Decimal(12, 2)
  costPrice           Decimal? @db.Decimal(12, 2)
  isAvailableInCountry Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  country             Country  @relation(fields: [countryCode], references: [code])

  @@unique([productId, countryCode])
  @@map("product_country_prices")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  variantId   String?  @db.Uuid
  url         String   @db.VarChar(500)
  altText     String?  @db.VarChar(255)
  sortOrder   Int      @default(0)
  isThumbnail Boolean  @default(false)
  mediaType   String   @default("IMAGE") @db.VarChar(20) // IMAGE, VIDEO

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id              String            @id @default(uuid()) @db.Uuid
  productId       String            @db.Uuid
  sku             String            @unique @db.VarChar(100)
  barcode         String?           @db.VarChar(100)
  title           String            @db.VarChar(150)
  attributes      Json              // e.g. {"color": "Blue", "size": "XL"}
  weightGrams     Int?
  lengthCm        Decimal?          @db.Decimal(8, 2)
  widthCm         Decimal?          @db.Decimal(8, 2)
  heightCm        Decimal?          @db.Decimal(8, 2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLevels InventoryLevel[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  auctions        Auction[]

  @@index([productId])
  @@map("product_variants")
}

// ------------------------------------------------------------------------------
// WAREHOUSES & MULTI-LOCATION INVENTORY
// ------------------------------------------------------------------------------

model Warehouse {
  id              String           @id @default(uuid()) @db.Uuid
  sellerId        String           @db.Uuid
  name            String           @db.VarChar(150)
  countryCode     String           @db.VarChar(2)
  addressId       String           @db.Uuid
  contactPhone    String           @db.VarChar(25)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  seller          SellerProfile    @relation(fields: [sellerId], references: [id])
  country         Country          @relation(fields: [countryCode], references: [code])
  address         Address          @relation(fields: [addressId], references: [id])
  inventoryLevels InventoryLevel[]

  @@index([sellerId])
  @@index([countryCode])
  @@map("warehouses")
}

model InventoryLevel {
  id                    String         @id @default(uuid()) @db.Uuid
  variantId             String         @db.Uuid
  warehouseId           String         @db.Uuid
  quantityAvailable     Int            @default(0)
  quantityReserved      Int            @default(0)
  safetyStockThreshold  Int            @default(5)
  restockLeadDays       Int            @default(3)
  updatedAt             DateTime       @updatedAt

  variant               ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse             Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@map("inventory_levels")
}

// ------------------------------------------------------------------------------
// CARTS
// ------------------------------------------------------------------------------

model Cart {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String?    @unique @db.Uuid
  guestSessionId  String?    @unique @db.VarChar(255)
  countryCode     String     @default("NP") @db.VarChar(2)
  currencyCode    String     @default("NPR") @db.VarChar(3)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user            User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           CartItem[]

  @@map("carts")
}

model CartItem {
  id              String         @id @default(uuid()) @db.Uuid
  cartId          String         @db.Uuid
  variantId       String         @db.Uuid
  quantity        Int            @default(1)
  unitPrice       Decimal        @db.Decimal(12, 2)
  addedAt         DateTime       @default(now())

  cart            Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ------------------------------------------------------------------------------
// ORDERS, ITEMS, TIMELINE & LOCALIZED INVOICING
// ------------------------------------------------------------------------------

model Order {
  id                     String               @id @default(uuid()) @db.Uuid
  orderNumber            String               @unique @db.VarChar(50) // e.g. ORD-2026-NP-0001
  userId                 String               @db.Uuid
  shippingAddressId      String               @db.Uuid
  countryCode            String               @db.VarChar(2)
  currencyCode           String               @db.VarChar(3)
  orderStatus            OrderStatus          @default(PENDING_PAYMENT)
  paymentStatus          PaymentStatus        @default(PENDING)
  paymentMethod          String               @db.VarChar(50) // ESEWA, RAZORPAY, STRIPE, COD, etc.

  subtotalAmount         Decimal              @db.Decimal(12, 2)
  discountAmount         Decimal              @default(0.00) @db.Decimal(12, 2)
  shippingAmount         Decimal              @default(0.00) @db.Decimal(12, 2)
  taxAmount              Decimal              @default(0.00) @db.Decimal(12, 2)
  grandTotalAmount       Decimal              @db.Decimal(12, 2)

  // Cash On Delivery (COD) Engine Details
  isCod                  Boolean              @default(false)
  codFee                 Decimal              @default(0.00) @db.Decimal(10, 2)
  codRiskLevel           CodRiskLevel         @default(LOW)
  codOtpVerified         Boolean              @default(false)

  notes                  String?              @db.Text
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  user                   User                 @relation(fields: [userId], references: [id])
  shippingAddress        Address              @relation(fields: [shippingAddressId], references: [id])
  country                Country              @relation(fields: [countryCode], references: [code])

  items                  OrderItem[]
  timeline               OrderTimeline[]
  invoices               Invoice[]
  paymentTransactions    PaymentTransaction[]
  shipments              Shipment[]
  escrowHolds            EscrowHold[]
  orderReturns           OrderReturn[]
  couponUsages           CouponUsage[]

  @@index([orderNumber])
  @@index([userId])
  @@index([orderStatus])
  @@index([countryCode])
  @@map("orders")
}

model OrderItem {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @db.Uuid
  sellerId         String         @db.Uuid
  storeId          String         @db.Uuid
  variantId        String         @db.Uuid
  productTitle     String         @db.VarChar(255)
  variantTitle     String         @db.VarChar(150)
  sku              String         @db.VarChar(100)
  unitPrice        Decimal        @db.Decimal(12, 2)
  quantity         Int            @default(1)
  taxRatePercent   Decimal        @default(0.00) @db.Decimal(5, 2)
  taxAmount        Decimal        @default(0.00) @db.Decimal(12, 2)
  discountAmount   Decimal        @default(0.00) @db.Decimal(12, 2)
  totalPrice       Decimal        @db.Decimal(12, 2)
  itemStatus       String         @default("PENDING") @db.VarChar(50)

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller           SellerProfile  @relation(fields: [sellerId], references: [id])
  store            Store          @relation(fields: [storeId], references: [id])
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  orderReturns     OrderReturn[]
  reviews          Review[]

  @@index([orderId])
  @@index([sellerId])
  @@map("order_items")
}

model OrderTimeline {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  status      String   @db.VarChar(50)
  title       String   @db.VarChar(150)
  description String?  @db.Text
  triggeredBy String?  @db.VarChar(100)
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_timelines")
}

model Invoice {
  id                      String    @id @default(uuid()) @db.Uuid
  invoiceNumber           String    @unique @db.VarChar(50) // INV-NP-2026-0001 / INV-IN-2026-0001 / INV-AE-2026-0001
  orderId                 String    @db.Uuid
  countryCode             String    @db.VarChar(2)
  taxRegistrationNumber   String?   @db.VarChar(50) // PAN / GSTIN / TRN
  pdfUrl                  String?   @db.VarChar(500)
  bilingualData           Json?     // Arabic/English or Nepali/English line items & tax breakdowns
  issuedAt                DateTime  @default(now())

  order                   Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@index([orderId])
  @@map("invoices")
}

// ------------------------------------------------------------------------------
// PAYMENTS, ESCROW & SELLER PAYOUTS
// ------------------------------------------------------------------------------

model PaymentTransaction {
  id                   String        @id @default(uuid()) @db.Uuid
  orderId              String        @db.Uuid
  gatewayProvider      String        @db.VarChar(50) // ESEWA, KHALTI, RAZORPAY, STRIPE, TABBY, COD
  transactionReference String        @unique @db.VarChar(150)
  externalPaymentId    String?       @db.VarChar(150)
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @db.VarChar(3)
  status               PaymentStatus @default(PENDING)
  rawResponse          Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds              Refund[]

  @@index([orderId])
  @@index([transactionReference])
  @@map("payment_transactions")
}

model EscrowHold {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @db.Uuid
  sellerId              String        @db.Uuid
  totalAmount           Decimal       @db.Decimal(12, 2)
  commissionFee         Decimal       @db.Decimal(12, 2)
  taxWithheldTcs        Decimal       @default(0.00) @db.Decimal(12, 2)
  netPayableToSeller    Decimal       @db.Decimal(12, 2)
  escrowStatus          EscrowStatus  @default(HELD)
  releaseEligibleAt     DateTime
  releasedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller                SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([sellerId])
  @@map("escrow_holds")
}

model SellerPayout {
  id                 String       @id @default(uuid()) @db.Uuid
  sellerId           String       @db.Uuid
  amount             Decimal      @db.Decimal(12, 2)
  currency           String       @db.VarChar(3)
  payoutMethod       String       @db.VarChar(50) // BANK_TRANSFER, CONNECT_IPS, NEFT, UAE_FTS
  destinationAccount String       @db.VarChar(100)
  status             PayoutStatus @default(PENDING)
  referenceNumber    String?      @unique @db.VarChar(100)
  processedAt        DateTime?
  createdAt          DateTime     @default(now())

  seller             SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@map("seller_payouts")
}

// ------------------------------------------------------------------------------
// SHIPMENTS & LOGISTICS
// ------------------------------------------------------------------------------

model Shipment {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @db.Uuid
  courierPartner        String          @db.VarChar(50) // DELHIVERY, SHIPROCKET, ARAMEX, PATHAO, LOCAL_FLEET
  trackingNumber        String          @unique @db.VarChar(100)
  waybillUrl            String?         @db.VarChar(500)
  estimatedDeliveryDate DateTime?
  actualDeliveryDate    DateTime?
  shippingStatus        String          @default("MANIFESTED") @db.VarChar(50)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events                ShipmentEvent[]

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentEvent {
  id             String    @id @default(uuid()) @db.Uuid
  shipmentId     String    @db.Uuid
  status         String    @db.VarChar(50)
  location       String?   @db.VarChar(150)
  description    String?   @db.Text
  eventTimestamp DateTime  @default(now())

  shipment       Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_events")
}

// ------------------------------------------------------------------------------
// RETURNS, DISPUTES & REFUNDS
// ------------------------------------------------------------------------------

model OrderReturn {
  id             String       @id @default(uuid()) @db.Uuid
  orderId        String       @db.Uuid
  orderItemId    String       @db.Uuid
  userId         String       @db.Uuid
  sellerId       String       @db.Uuid
  reason         String       @db.VarChar(255)
  evidenceImages Json?
  returnStatus   ReturnStatus @default(REQUESTED)
  trackingNumber String?      @db.VarChar(100)
  requestedAt    DateTime     @default(now())
  resolvedAt     DateTime?

  order          Order        @relation(fields: [orderId], references: [id])
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  seller         SellerProfile @relation(fields: [sellerId], references: [id])
  refunds        Refund[]

  @@index([orderId])
  @@index([userId])
  @@index([sellerId])
  @@map("order_returns")
}

model Refund {
  id                   String             @id @default(uuid()) @db.Uuid
  orderReturnId        String?            @db.Uuid
  paymentTransactionId String             @db.Uuid
  amount               Decimal            @db.Decimal(12, 2)
  currency             String             @db.VarChar(3)
  refundReason         String?            @db.VarChar(255)
  status               String             @default("PENDING") @db.VarChar(50)
  createdAt            DateTime           @default(now())

  orderReturn          OrderReturn?       @relation(fields: [orderReturnId], references: [id])
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id])

  @@map("refunds")
}

// ------------------------------------------------------------------------------
// REVIEWS, RATINGS & SOCIAL PROOF
// ------------------------------------------------------------------------------

model Review {
  id                 String    @id @default(uuid()) @db.Uuid
  productId          String    @db.Uuid
  userId             String    @db.Uuid
  orderItemId        String?   @db.Uuid
  rating             Int       // 1 - 5 stars
  title              String?   @db.VarChar(150)
  comment            String?   @db.Text
  photoUrls          Json?
  isVerifiedPurchase Boolean   @default(false)
  helpfulVotes       Int       @default(0)
  isApproved         Boolean   @default(true)
  createdAt          DateTime  @default(now())

  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem          OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

// ------------------------------------------------------------------------------
// PROMOTIONS & COUPONS
// ------------------------------------------------------------------------------

model Coupon {
  id                 String        @id @default(uuid()) @db.Uuid
  code               String        @unique @db.VarChar(50)
  description        String?       @db.VarChar(255)
  discountType       String        @db.VarChar(20) // PERCENTAGE, FIXED_AMOUNT
  discountValue      Decimal       @db.Decimal(10, 2)
  minOrderValue      Decimal       @default(0.00) @db.Decimal(10, 2)
  maxDiscountAmount  Decimal?      @db.Decimal(10, 2)
  applicableCountry  String?       @db.VarChar(2) // NP, IN, AE or NULL (all)
  startsAt           DateTime
  expiresAt          DateTime
  usageLimit         Int?
  usageCount         Int           @default(0)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())

  usages             CouponUsage[]

  @@index([code])
  @@map("coupons")
}

model CouponUsage {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @db.Uuid
  userId         String   @db.Uuid
  orderId        String   @db.Uuid
  discountAmount Decimal  @db.Decimal(10, 2)
  usedAt         DateTime @default(now())

  coupon         Coupon   @relation(fields: [couponId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

// ------------------------------------------------------------------------------
// AUCTIONS & BIDDING (eBay-Style)
// ------------------------------------------------------------------------------

model Auction {
  id                 String        @id @default(uuid()) @db.Uuid
  productId          String        @unique @db.Uuid
  variantId          String?       @db.Uuid
  startingBidPrice   Decimal       @db.Decimal(12, 2)
  reservePrice       Decimal?      @db.Decimal(12, 2)
  bidIncrement       Decimal       @default(100.00) @db.Decimal(10, 2)
  currentHighestBid  Decimal       @default(0.00) @db.Decimal(12, 2)
  currentWinnerId    String?       @db.Uuid
  currency           String        @db.VarChar(3)
  status             AuctionStatus @default(SCHEDULED)
  startsAt           DateTime
  endsAt             DateTime
  totalBids          Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant            ProductVariant? @relation(fields: [variantId], references: [id])
  bids               AuctionBid[]

  @@index([status])
  @@map("auctions")
}

model AuctionBid {
  id             String   @id @default(uuid()) @db.Uuid
  auctionId      String   @db.Uuid
  bidderId       String   @db.Uuid
  bidAmount      Decimal  @db.Decimal(12, 2)
  isWinning      Boolean  @default(false)
  isProxyBid     Boolean  @default(false)
  maxProxyAmount Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  auction        Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder         User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([auctionId])
  @@index([bidderId])
  @@map("auction_bids")
}

// ------------------------------------------------------------------------------
// BULK RFQ (Alibaba-Style Wholesale & Tiered Quotes)
// ------------------------------------------------------------------------------

model RfqInquiry {
  id                   String   @id @default(uuid()) @db.Uuid
  buyerId              String   @db.Uuid
  productId            String   @db.Uuid
  targetQuantity       Int
  targetPricePerUnit   Decimal  @db.Decimal(12, 2)
  currency             String   @db.VarChar(3)
  destinationCountry   String   @db.VarChar(2)
  notes                String?  @db.Text
  status               String   @default("OPEN") @db.VarChar(50) // OPEN, QUOTED, ACCEPTED, REJECTED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  buyer                User     @relation(fields: [buyerId], references: [id])
  product              Product  @relation(fields: [productId], references: [id])

  @@index([buyerId])
  @@index([productId])
  @@map("rfq_inquiries")
}

// ------------------------------------------------------------------------------
// NOTIFICATIONS & MULTI-CHANNEL ALERTS
// ------------------------------------------------------------------------------

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  channel   NotificationChannel @default(IN_APP)
  title     String              @db.VarChar(200)
  message   String              @db.Text
  actionUrl String?             @db.VarChar(500)
  isRead    Boolean             @default(false)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
