# ==========================================
# DHANSHREE MULTI-VENDOR MARKETPLACE CONFIG (.env)
# Targeted Regions: Nepal (NP), India (IN), UAE (AE)
# ==========================================

NODE_ENV=development
APP_NAME="Dhanshree Multi-Vendor"
APP_DEFAULT_LOCALE=en
APP_DEFAULT_COUNTRY=NP

# Network & Ports
API_PORT=4000
WEB_PORT=3000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# PostgreSQL Database (Core Relational Store)
POSTGRES_USER=dhanshree_user
POSTGRES_PASSWORD=dhanshree_secret_pw
POSTGRES_DB=dhanshree_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Redis (Caching, Sessions, Carts, BullMQ Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# Search Engine (Meilisearch / Elasticsearch)
MEILI_HTTP_ADDR=http://localhost:7700
MEILI_MASTER_KEY=masterKey_Dhanshree_Secret_2026

# S3 Compatible Object Storage & CDN (MinIO / AWS S3 / Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_NAME=dhanshree-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true
CDN_PUBLIC_BASE_URL=http://localhost:9000/dhanshree-assets

# Authentication & Security
JWT_SECRET=dhanshree_jwt_sign_key_production_ready_xyz123!
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=dhanshree_refresh_jwt_sign_key_production_ready_abc456!
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=dhanshree_cookie_encryption_secret_2026
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Country-Specific Payment Adapters
# NEPAL GATEWAYS
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_API_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
KHALTI_PUBLIC_KEY=test_public_key_77a94b
KHALTI_SECRET_KEY=test_secret_key_88b12c
KHALTI_API_URL=https://a.khalti.com/api/v2
FONEPAY_MERCHANT_CODE=FONEPAY_TEST_01
FONEPAY_SECRET_KEY=fonepay_secret_key_test

# INDIA GATEWAYS
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=sampleSecretKeyIndia123
CASHFREE_APP_ID=sample_cf_app_id
CASHFREE_SECRET_KEY=sample_cf_secret_key
PAYU_MERCHANT_KEY=sample_payu_key
PAYU_MERCHANT_SALT=sample_payu_salt

# UAE GATEWAYS
STRIPE_PUBLISHABLE_KEY=pk_test_sampleStripeUaeKey
STRIPE_SECRET_KEY=sk_test_sampleStripeUaeSecret
STRIPE_WEBHOOK_SECRET=whsec_sampleUaeWebhook
TABBY_PUBLIC_KEY=pk_test_sampleTabbyUaeKey
TABBY_SECRET_KEY=sk_test_sampleTabbySecret
TELR_STORE_ID=sample_telr_store_id
TELR_AUTH_KEY=sample_telr_auth_key

# Logistics & Courier Partners
DELHIVERY_API_KEY=test_delhivery_api_key
SHIPROCKET_API_USER=test_shiprocket_email@market.com
SHIPROCKET_API_PASSWORD=test_shiprocket_password
ARAMEX_CLIENT_INFO_ACCOUNT_NUMBER=aramex_test_acc
PATHAO_NEPAL_CLIENT_ID=pathao_np_test_id
PATHAO_NEPAL_CLIENT_SECRET=pathao_np_test_secret

# Messaging & Growth Services (SMS OTP & WhatsApp)
SPARROW_SMS_TOKEN=sample_sparrow_np_token
MSG91_AUTH_KEY=sample_msg91_in_key
TWILIO_ACCOUNT_SID=sample_twilio_sid
TWILIO_AUTH_TOKEN=sample_twilio_token
WHATSAPP_CLOUD_API_TOKEN=sample_meta_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=sample_meta_phone_id

# Rate Limiting Configuration (Tiered & Exponential Backoff)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_IP_MAX=10
RATE_LIMIT_AUTH_IP_WINDOW_MS=60000
RATE_LIMIT_AUTH_ACCOUNT_MAX=5
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_MS=900000
RATE_LIMIT_AUTH_BASE_BACKOFF_SEC=5
RATE_LIMIT_AUTH_MAX_BACKOFF_SEC=1800
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_AUTHENTICATED_MAX=300
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=60000
